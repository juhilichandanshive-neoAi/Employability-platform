7. PINNED DEPENDENCIES
━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

  Package          Version   Reason pinned
  ───────────────  ────────  ──────────────────────────────────────────────────
  scikit-learn     1.5.2     Final model serialised with this version;
                             loading with a different version can silently
                             change predictions
  xgboost          3.4.1     Final model serialised with this version
