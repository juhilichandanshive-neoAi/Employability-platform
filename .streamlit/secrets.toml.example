# Streamlit OIDC Configuration Example for Google Sign-In
# Copy this file to .streamlit/secrets.toml and replace placeholders with your credentials.
# IMPORTANT: Never commit .streamlit/secrets.toml to version control!

[auth]
# Redirect URI registered in Google Cloud Console
# Local development default:
redirect_uri = "http://localhost:8501/oauth2callback"

# Secret key used to encrypt the authentication cookie (generate a random 32+ character string)
cookie_secret = "replace-with-a-long-random-string-at-least-32-chars"

# Google OAuth 2.0 Web Application Client ID
client_id = "your-google-oauth-client-id.apps.googleusercontent.com"

# Google OAuth 2.0 Client Secret
client_secret = "your-google-oauth-client-secret"

# OpenID Connect Discovery URL for Google
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
