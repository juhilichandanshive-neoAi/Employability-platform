# EmployaAI Platform Environment Variables
# Optional: Configure Google OAuth credentials if using Google Sign-In.
# If omitted or left blank, the app runs smoothly with local session authentication.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_COOKIE_SECRET=
AUTH_SERVER_METADATA_URL=https://accounts.google.com/.well-known/openid-configuration
AUTH_REDIRECT_URI=http://localhost:8501
